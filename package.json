{
  "name": "@o1-labs/mina-mcp-server",
  "version": "0.7.2",
  "description": "MCP server for Mina Protocol daemon and archive node",
  "mcpName": "io.github.MinaProtocol/mina-mcp-server",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mina-mcp-server": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "keywords": [
    "mina",
    "mina-protocol",
    "mcp",
    "model-context-protocol",
    "blockchain",
    "graphql",
    "ai"
  ],
  "homepage": "https://github.com/MinaProtocol/mina-mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MinaProtocol/mina-mcp-server.git"
  },
  "bugs": {
    "url": "https://github.com/MinaProtocol/mina-mcp-server/issues"
  },
  "author": "O(1) Labs <build@o1labs.org>",
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "start:snapshot": "node dist/index.js --mode snapshot",
    "start:tutorial": "node dist/index.js --mode tutorial",
    "capture-snapshot": "node dist/snapshots/capture.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:mcp": "vitest run test/mcp",
    "test:integration": "vitest run test/integration --test-timeout 120000",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@o1-labs/mina-archive-sdk": "^0.0.1",
    "@o1-labs/mina-rosetta-sdk": "^0.0.2",
    "@o1-labs/mina-sdk": "^0.3.0",
    "express": "^4.21.0",
    "mina-signer": "3.0.7",
    "pg": "^8.13.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.0",
    "vitest": "^3.1.1"
  }
}
