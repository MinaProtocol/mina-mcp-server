{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.minaprotocol/mina-mcp-server",
  "description": "Query Mina Protocol: accounts, blocks, transactions, zkApp events/actions, archive SQL, Rosetta.",
  "version": "0.7.0",
  "repository": {
    "url": "https://github.com/MinaProtocol/mina-mcp-server",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@o1-labs/mina-mcp-server",
      "version": "0.7.0",
      "transport": {
        "type": "stdio"
      },
      "runtimeHint": "npx",
      "packageArguments": [
        { "type": "named", "name": "--mode", "value": "live", "description": "Operating mode: live | tutorial | snapshot" },
        { "type": "named", "name": "--network", "value": "devnet", "description": "Public network for live mode: devnet | mainnet | mesa | mesa-mut" }
      ]
    }
  ]
}
